{
  "cli": {
    "version": ">= 22.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ADMOB_TEST_ADS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ADMOB_TEST_ADS": "true"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "MINION_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://minion.fan",
        "EXPO_PUBLIC_ADMOB_ENABLED": "true",
        "EXPO_PUBLIC_ADMOB_TEST_ADS": "false"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "store-release": {
      "android": {
        "track": "production",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      }
    },
    "admob-release": {
      "android": {
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6826082325"
      },
      "android": {
        "track": "alpha"
      }
    }
  }
}

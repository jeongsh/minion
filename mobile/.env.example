# 휴대폰에서 접근 가능한 PC의 LAN 주소를 사용하세요.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# 앱에는 publishable key만 넣습니다. service role/secret key는 절대 넣지 마세요.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Development/preview builds use test banners. Rebuild after changing these.
EXPO_PUBLIC_ADMOB_ENABLED=true
EXPO_PUBLIC_ADMOB_TEST_ADS=true

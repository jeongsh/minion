{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hnd1"],
  "routes": [
    {
      "src": "/_next/image",
      "mitigate": {
        "action": "deny"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/match-previews",
      "schedule": "45 21 * * *"
    },
    {
      "path": "/api/cron/site-metrics",
      "schedule": "0 21 * * *"
    }
  ]
}

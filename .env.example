# Public site information
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# Google AdSense
# Keep these empty until the site and account are approved. The app hides empty
# production slots automatically; local development still shows placeholders.
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HORIZONTAL=
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=
NEXT_PUBLIC_ADSENSE_SLOT_COMMUNITY=
NEXT_PUBLIC_ADSENSE_SLOT_PREDICTION=
NEXT_PUBLIC_ADSENSE_ENABLE_PREDICTIONS=false
NEXT_PUBLIC_ADSENSE_SHOW_PLACEHOLDERS=false

# Community AI moderation (optional)
# 미설정 시 AI 검수를 건너뛴다(금칙어 필터·신고 누적 블라인드는 그대로 동작).
# 혐오/성적/폭력은 무료 Moderation API, 광고/도박 분류는 아래 모델을 사용.
OPENAI_API_KEY=
OPENAI_COMMUNITY_MODERATION_MODEL=gpt-5.4-mini

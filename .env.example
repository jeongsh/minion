# Public site information
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# Supabase
# NEXT_PUBLIC_* values are browser-visible. Never put service-role or secret keys
# in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=

# Optional comma-separated allowlist for admin pages when app_metadata roles are
# not configured yet. Prefer Supabase Auth app_metadata role/roles for production.
ADMIN_EMAILS=
ADMIN_ALLOW_ALL_USERS=false

# App maintenance jobs
CRON_SECRET=

# Google AdSense
# Keep these empty until the site and account are approved. The app hides empty
# production slots automatically; local development still shows placeholders.
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HORIZONTAL=
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=
NEXT_PUBLIC_ADSENSE_SLOT_COMMUNITY=
NEXT_PUBLIC_ADSENSE_SLOT_PREDICTION=
NEXT_PUBLIC_ADSENSE_ENABLE_PREDICTIONS=false
NEXT_PUBLIC_ADSENSE_SHOW_PLACEHOLDERS=false

# Community AI moderation (optional)
# Leave OPENAI_API_KEY empty to use only the local profanity/spam checks.
OPENAI_API_KEY=
OPENAI_COMMUNITY_MODERATION_MODEL=gpt-5.4-mini

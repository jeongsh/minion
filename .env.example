# Public site information
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# Supabase
# NEXT_PUBLIC_* values are browser-visible. Never put service-role or secret keys
# in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
COMMUNITY_GUEST_IP_SECRET=
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=

# Optional comma-separated allowlist for admin pages when app_metadata roles are
# not configured yet. Prefer Supabase Auth app_metadata role/roles for production.
ADMIN_EMAILS=
ADMIN_ALLOW_ALL_USERS=false

# App maintenance jobs
CRON_SECRET=

# Google AdSense
# Ads and design placeholders stay off unless ADSENSE_ENABLED is explicitly true.
# Keep publisher/slot settings for later reactivation; rebuild after changing flags.
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_SLOT_HORIZONTAL=
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=
NEXT_PUBLIC_ADSENSE_SLOT_COMMUNITY=
NEXT_PUBLIC_ADSENSE_SLOT_PREDICTION=
NEXT_PUBLIC_ADSENSE_ENABLE_PREDICTIONS=false
NEXT_PUBLIC_ADSENSE_SHOW_PLACEHOLDERS=false

# Community AI moderation (optional)
# Leave OPENAI_API_KEY empty to disable automated gambling/illegal-ad screening.
OPENAI_API_KEY=
OPENAI_COMMUNITY_MODERATION_MODEL=gpt-5.4-mini

# Admin-only AI character draft studio; uses the server-side OPENAI_API_KEY above.
OPENAI_COMMUNITY_STUDIO_MODEL=gpt-5.4
OPENAI_COMMUNITY_STUDIO_SEARCH_MODEL=gpt-5.4-mini
OPENAI_COMMUNITY_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Video analysis requires these binaries on the server (empty uses PATH).
STUDIO_YTDLP_PATH=
STUDIO_FFMPEG_PATH=
STUDIO_FFPROBE_PATH=

# Optional dedicated calendar-review webhook. When empty, the server falls back
# to DISCORD_COMMUNITY_WEBHOOK_URL if that variable is configured at runtime.
DISCORD_CALENDAR_WEBHOOK_URL=

# NAVER API HUB news search (server only)
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# Naver Login (web + native app broker)
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=

# Cloudflare R2 (instagram-media object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.minion.fan
